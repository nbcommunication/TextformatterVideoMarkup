<?php namespace ProcessWire;

/**
 * Textformatter Video Markup
 *
 * #pw-summary Render oEmbed data from YouTube/Vimeo URLs.
 * #pw-body Based on TextformatterVideoEmbed by Ryan Cramer and TextformatterVideoEmbedOptions by Steffen Henschel.
 *
 * @copyright 2026 NB Communication Ltd
 * @license Mozilla Public License v2.0 http://mozilla.org/MPL/2.0/
 *
 * @property Field $field
 * @property bool $html
 * @property bool $isHtml
 * @property Page $page
 *
 */

class TextformatterVideoMarkup extends Textformatter implements ConfigurableModule {

	/**
	 * getModuleInfo is a module required by all modules to tell ProcessWire about them
	 *
	 * @return array
	 *
	 */
	public static function getModuleInfo() {
		return [
			'title' => 'Video markup for YouTube/Vimeo',
			'version' => 120,
			'summary' => 'Render oEmbed data from YouTube/Vimeo URLs.',
			'author' => 'nbcommunication',
			'href' => 'https://github.com/nbcommunication/TextformatterVideoMarkup',
			'icon' => 'video-camera',
			'requires' => 'ProcessWire>=3.0.148,PHP>=7.4',
		];
	}

	const noCookie = 'noCookie';

	/**
	 * Timezone of Vimeo's oEmbed `upload_date` (Y-m-d H:i:s, no offset given)
	 *
	 */
	const vimeoUploadDateTimezone = 'UTC';

	/**
	 * YouTube Data API v3 videos endpoint
	 *
	 */
	const youtubeApiEndpoint = 'https://www.googleapis.com/youtube/v3/videos';

	/**
	 * Cache name prefix for YouTube Data API responses
	 *
	 */
	const youtubeApiCachePrefix = 'yt-api-';

	/**
	 * Default cache expiry for YouTube Data API responses (30 days)
	 *
	 */
	const youtubeApiCacheExpiry = 2592000;

	/**
	 * YouTube Data API video resource parts requested
	 *
	 * All parts that are available with an API key (fileDetails, processingDetails
	 * and suggestions are only available to the video owner via OAuth).
	 *
	 */
	const youtubeApiParts = [
		'snippet',
		'contentDetails',
		'status',
		'statistics',
		'player',
		'topicDetails',
		'recordingDetails',
		'liveStreamingDetails',
		'localizations',
	];

	/**
	 * The field
	 *
	 * @var Field
	 *
	 */
	public $field = null;

	/**
	 * Is HTML?
	 *
	 * @var bool
	 * @todo should be private?
	 *
	 */
	public $html = false;

	/**
	 * Is HTML?
	 *
	 * @var bool
	 *
	 */
	public $isHtml = false;

	/**
	 * The page
	 *
	 * @var Page
	 *
	 */
	public $page = null;

	/**
	 * Format the given text string with Page and Field provided.
	 *
	 * @param Page $page
	 * @param Field $field
	 * @param string|mixed $value Value is provided as a reference, so is modified directly (not returned).
	 *
	 */
	public function formatValue(Page $page, Field $field, &$value) {

		$this->page = $page;
		$this->field = $field;

		// Is HTML being parsed?
		if($field instanceof Field && $page instanceof Page) {
			$of = $page->of();
			$page->of(false); // Set output formatting to false before getting the Inputfield
			$inputfield = $field->getInputfield($page);
			$this->html = $this->isHtml ?: $inputfield instanceof InputfieldTextarea && $inputfield->contentType >= 1;
			$page->of($of);
		}

		$value = str_replace('&amp;', '&', (string) $value);

		$this->renderYoutube($value);
		$this->renderVimeo($value);
		$this->isHtml = false; // reset for next use
	}

	/**
	 * Render the data
	 *
	 * @param string $tpl
	 * @param array|null $data
	 * @param string $line
	 * @param string|null $emptyValue
	 * @return string
	 *
	 */
	public function ___render($tpl, $data, $line, $emptyValue = null) {
		if(!is_array($data)) {
			if(is_null($emptyValue)) $emptyValue = $this->emptyValue;
			if(strpos($emptyValue, '{link}') !== false) {
				$url = $this->html ? strip_tags($line) : $line;
				$link = "<a href=$url target=_blank rel=noopener>$url</a>";
				$emptyValue = str_replace('{link}', ($this->html ? "<p>$link</p>" : $link), $emptyValue);
			}
			$emptyValue = str_replace('{url}', $line, $emptyValue);
			return $emptyValue;
		}
		foreach($data as $key => $value) {
			if(!is_array($value)) {
				$tpl = str_replace('{' . $key .'}', (string) $value, $tpl);
			}
		}
		return $tpl;
	}

	/**
	 * Apply options
	 *
	 * @param string $prefix
	 * @param string $url
	 * @return string
	 *
	 */
	protected function applyOptions($prefix, $url) {

		$prefix = "{$prefix}_";
		$query = [];
		$url = explode('?', $url);

		if(count($url) > 1) {
			parse_str($url[1], $q);
			$query = array_merge($query, $q);
		}

		foreach($this->data as $key => $value) {
			if($value === '' || substr($key, 3) === self::noCookie) continue;
			if(substr($key, 0, 3) == $prefix) {
				$key = str_replace($prefix, '', $key);
				if(!isset($query[$key])) {
					$query[$key] = $value;
				}
			}
		}

		// Apply current language if multi-language enabled (and not the default language,
		// since its name - conventionally "default" - is not a usable language code)
		if($this->wire()->languages !== null) {
			$userLanguage = $this->wire()->user->language;
			$lang = ($userLanguage && !$userLanguage->isDefault) ? $userLanguage->name : '';
			if($lang) {
				foreach([
					'yt' => ['cc_lang_pref', 'hl'],
					'vm' => ['texttrack'],
				] as $provider => $keys) {
					if($prefix == "{$provider}_") {
						foreach($keys as $key) {
							if(!isset($query[$key])) {
								$query[$key] = $lang;
							}
						}
					}
				}
			}
		}

		foreach($query as $key => $value) {
			// Remove # on vm_color
			if($key == 'color' && $prefix == 'vm_' && is_string($value)) $query[$key] = ltrim($value, '#');
		}

		return $url[0] . (count($query) ? '?' . http_build_query($query) : '');
	}

	/**
	 * Apply Vimeo options
	 *
	 * Based on TextformatterVideoEmbedOptions::applyVimeo by Steffen Henschel.
	 *
	 * @param string $url
	 * @return string
	 *
	 */
	protected function applyVimeoOptions($url) {
		return $this->applyOptions('vm', $url);
	}

	/**
	 * Apply YouTube options
	 *
	 * Based on TextformatterVideoEmbedOptions::applyYoutube by Steffen Henschel.
	 *
	 * @param string $url
	 * @return string
	 *
	 */
	protected function applyYoutubeOptions($url) {
		return $this->applyOptions('yt', $this->applyYoutubeNoCookie($url));
	}

	/**
	 * Apply the YouTube 'No Cookie' URL
	 *
	 * @param string $url
	 * @return string
	 *
	 */
	protected function applyYoutubeNoCookie($url) {
		return $this->yt_noCookie ? str_replace('youtube.com', 'youtube-nocookie.com', $url) : $url;
	}

	/**
	 * Given a service oembed URL and video ID, return its oEmbed data.
	 *
	 * A cached version of the data will be used if possible. When not possible,
	 * it will be retrieved from the service's oembed URL, and then cached.
	 *
	 * @param string $provider
	 * @param string $url
	 * @param string $originalUrl
	 * @return array
	 *
	 */
	protected function getData($provider, $url, $originalUrl = '') {

		$isYoutube = $provider == 'yt';
		$endpoint = $this->getOembedEndpoint($provider, $url);

		$cache = $this->wire()->cache;
		$name = $this->getOembedCacheName($endpoint);
		$data = $cache->getFor($this, $name);

		if(!is_array($data)) {
			$http = $this->wire(new WireHttp());
			$response = $http->getJSON($endpoint);
			if($response && is_array($response) && count($response)) {
				$data = $response;
				$expire = $this->oembedCacheExpiry;
				if(is_numeric($expire)) $expire = (int) $expire;
				$cache->saveFor($this, $name, $data, $expire ?: WireCache::expireNever);
			} else {
				// Cache failures (e.g. deleted, private or mistyped videos) for an hour,
				// so the endpoint isn't requested again on every render
				$this->wire()->log->save(
					'textformatter-video-markup',
					sprintf('oEmbed request failed for %s (HTTP %s)', $url, $http->getHttpCode())
				);
				$data = ['error' => (int) $http->getHttpCode() ?: 1];
				$cache->saveFor($this, $name, $data, WireCache::expireHourly);
			}
		}

		if(isset($data['error'])) $data = false;

		if(is_array($data)) {

			// Entity encode the oEmbed text values (the embed html is left as it is)
			$data = $this->encodeData($data, ['html']);

			$data['html'] = $data['html'] ?? '';

			$query = explode('?', $url, 2);
			if(count($query) > 1 && $data['html']) {
				$query = str_replace('&amp;', '&', $query[1]);
				if($isYoutube) {
					$query = explode('&', $query, 2);
					$query = count($query) > 1 ? trim($query[1], '&') : '';
				}
				if($query) {
					// Add the query to the iframe src only (not e.g. a title containing '?')
					$data['html'] = preg_replace_callback('/(<iframe[^>]*?\ssrc=")([^"]*)"/', function($m) use ($query) {
						$src = strpos($m[2], '?') !== false ? str_replace('?', "?$query&", $m[2]) : "$m[2]?$query";
						return "$m[1]$src\"";
					}, $data['html'], 1);
					$data['params'] = $query;
				}
			}

			if($isYoutube) $data['html'] = $this->applyYoutubeNoCookie($data['html']);

			$data['url'] = $originalUrl ?: $url;
			preg_match('/<iframe.*?src="(.*?)"/', $data['html'], $matches);
			$data['embedUrl'] = count($matches) ? $matches[1] : '';
			$data['width'] = $data['width'] ?? $this->maxWidth;
			$data['height'] = $data['height'] ?? $this->maxHeight;
			$data['class'] = $provider;

			if($data['embedUrl'] && !isset($data['video_id'])) {
				$segments = explode('/', explode('?', $data['embedUrl'])[0]);
				$data['video_id'] = end($segments);
			}

			// Defensive defaults, as these may not always be present (e.g. no query
			// string on the source URL, or fields omitted from the oEmbed response)
			$data['video_id'] = $data['video_id'] ?? '';
			$data['params'] = $data['params'] ?? '';
			$data['title'] = $data['title'] ?? '';

			// Extend with YouTube Data API data if an API key has been provided
			if($isYoutube && $data['video_id'] && $this->youtubeApiKey) {
				$data += $this->getYoutubeApiData($data['video_id']);
			}

			// Vimeo: add the ISO 8601 publish date and timestamp, matching the YouTube Data API keys
			if(!$isYoutube && !empty($data['upload_date']) && !isset($data['published_at'])) {
				try {
					$date = new \DateTime($data['upload_date'], new \DateTimeZone(self::vimeoUploadDateTimezone));
					$data['published_at'] = $date->format(\DateTime::ATOM);
					$data['published_timestamp'] = $date->getTimestamp();
				} catch(\Exception $e) {
					$data['published_at'] = '';
					$data['published_timestamp'] = 0;
				}
			}

			// lite facade
			$type = $isYoutube ? 'youtube' : 'vimeo';
			$data['lite'] = "<lite-$type videoid=\"{$data['video_id']}\" params=\"{$data['params']}\" playlabel=\"{$this->_('Play')}: {$data['title']}\"></lite-$type>";

			if($this->wire()->config->debug) {
				$table = $this->wire()->modules->get('MarkupAdminDataTable');
				foreach($data as $key => $value) {
					$table->row([$key, is_array($value) ? '<pre>' . htmlspecialchars(json_encode($value, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)) . '</pre>' : $value]);
				}
				$data['debug'] = "<h3>$url</h3>" . $table->render();
			} else {
				$data['debug'] = '';
			}
		}

		return is_array($data) ? $data : [];
	}

	/**
	 * Get the oEmbed endpoint URL for a video URL
	 *
	 * @param string $provider `yt` or `vm`
	 * @param string $url The video URL, with options applied
	 * @return string
	 *
	 */
	protected function getOembedEndpoint($provider, $url) {

		$query = [
			'url' => $url,
			'maxwidth' => $this->maxWidth,
			'maxheight' => $this->maxHeight,
		];

		if($provider == 'yt') {
			$query['format'] = 'json';
		}

		return ($provider == 'yt' ?
			'https://www.youtube.com/oembed' :
			'https://vimeo.com/api/oembed.json'
		) . '?' . http_build_query($query);
	}

	/**
	 * Get the cache name for an oEmbed endpoint URL
	 *
	 * @param string $endpoint
	 * @return string
	 *
	 */
	protected function getOembedCacheName($endpoint) {
		return md5($endpoint);
	}

	/**
	 * Entity encode the string values of an array
	 *
	 * @param array $data
	 * @param array $skip Keys to leave as they are (e.g. embed markup)
	 * @return array
	 *
	 */
	protected function encodeData(array $data, array $skip = []) {
		$sanitizer = $this->wire()->sanitizer;
		foreach($data as $key => $value) {
			if(is_string($value) && !in_array($key, $skip, true)) $data[$key] = $sanitizer->entities($value);
		}
		return $data;
	}

	/**
	 * Get additional data for a YouTube video from the YouTube Data API
	 *
	 * Requires the `youtubeApiKey` config value to be set. The key is sent as a
	 * header, so it never appears in a URL. Responses are cached for the duration
	 * set by `youtubeApiCacheExpiry` (default 30 days, the maximum the YouTube API
	 * Services terms allow API data to be stored without being refreshed).
	 * Failed requests are cached for an hour to avoid repeatedly hitting the API.
	 *
	 * @param string $videoId
	 * @return array
	 *
	 */
	protected function getYoutubeApiData($videoId) {

		$cache = $this->wire()->cache;
		$name = self::youtubeApiCachePrefix . $videoId;
		$item = $cache->getFor($this, $name);

		if(!is_array($item)) {

			$http = $this->wire(new WireHttp());
			$http->setHeader('X-Goog-Api-Key', $this->youtubeApiKey);
			$response = $http->getJSON(self::youtubeApiEndpoint . '?' . http_build_query([
				'id' => $videoId,
				'part' => implode(',', self::youtubeApiParts),
			]));

			if(is_array($response) && isset($response['items'][0]) && is_array($response['items'][0])) {
				$item = $response['items'][0];
				$expire = (int) $this->youtubeApiCacheExpiry ?: self::youtubeApiCacheExpiry;
			} else {
				$this->wire()->log->save(
					'textformatter-video-markup',
					is_array($response) ?
						sprintf('YouTube Data API returned no data for video %s', $videoId) :
						sprintf('YouTube Data API request failed for video %s (HTTP %s)', $videoId, $http->getHttpCode())
				);
				$item = ['error' => (int) $http->getHttpCode() ?: 1];
				$expire = WireCache::expireHourly;
			}

			$cache->saveFor($this, $name, $item, $expire);
		}

		if(empty($item['id'])) return [];

		return $this->parseYoutubeApiData($item);
	}

	/**
	 * Convert a YouTube Data API video resource into flat placeholder data
	 *
	 * Every field is flattened to a snake_case key (e.g. `statistics.viewCount`
	 * becomes `view_count`, `snippet.thumbnails.maxres.url` becomes `thumbnails_maxres_url`).
	 * Lists of values are comma-separated, booleans are 0/1, and string values are
	 * entity encoded (other than `embed_html`). The raw resource is available as `youtube`.
	 *
	 * Some keys are normalised to match Vimeo's oEmbed data, so the same
	 * placeholders work for both providers: `duration` (seconds), `upload_date`
	 * (Y-m-d H:i:s, UTC) and `description`.
	 *
	 * @param array $item
	 * @return array
	 *
	 */
	protected function parseYoutubeApiData(array $item) {

		$data = [];
		foreach(self::youtubeApiParts as $part) {
			if(!isset($item[$part]) || !is_array($item[$part])) continue;
			$data += $this->flattenYoutubeApiData($item[$part], ($part === 'localizations' ? 'localizations_' : ''));
		}

		$data = $this->encodeData($data, ['embed_html']);

		// Duration: seconds (as Vimeo), ISO 8601 and formatted
		$seconds = 0;
		$data['duration_iso'] = $data['duration'] ?? '';
		if($data['duration_iso']) {
			try {
				$interval = new \DateInterval($data['duration_iso']);
				$seconds = ($interval->d * 86400) + ($interval->h * 3600) + ($interval->i * 60) + $interval->s;
			} catch(\Exception $e) {
				$seconds = 0;
			}
		}
		$data['duration'] = $seconds;
		$data['duration_formatted'] = $seconds ? (
			$seconds >= 3600 ?
				sprintf('%d:%02d:%02d', floor($seconds / 3600), floor(($seconds % 3600) / 60), $seconds % 60) :
				sprintf('%d:%02d', floor($seconds / 60), $seconds % 60)
		) : '';

		// Publish date: ISO 8601 (published_at), timestamp, and Vimeo's upload_date format
		$timestamp = !empty($data['published_at']) ? (int) strtotime($data['published_at']) : 0;
		$data['published_timestamp'] = $timestamp;
		$data['upload_date'] = $timestamp ? gmdate('Y-m-d H:i:s', $timestamp) : '';

		$data['channel_url'] = !empty($data['channel_id']) ? "https://www.youtube.com/channel/{$data['channel_id']}" : '';

		// The raw API resource, for use in render() hooks
		$data['youtube'] = $item;

		return $data;
	}

	/**
	 * Flatten a YouTube Data API array to snake_case keys with scalar values
	 *
	 * @param array $values
	 * @param string $prefix
	 * @return array
	 *
	 */
	protected function flattenYoutubeApiData(array $values, $prefix = '') {
		$data = [];
		foreach($values as $key => $value) {
			// camelCase to snake_case (other keys, e.g. language codes, are left as they are)
			if(preg_match('/^[a-z][a-zA-Z0-9]*$/', $key)) $key = strtolower(preg_replace('/[A-Z]/', '_$0', $key));
			$key = $prefix . $key;
			if(is_array($value)) {
				$isList = $value === array_values($value) && !count(array_filter($value, 'is_array'));
				if($isList) {
					$data[$key] = implode(', ', array_map(function($v) {
						return is_bool($v) ? (int) $v : $v;
					}, $value));
				} else {
					$data += $this->flattenYoutubeApiData($value, "{$key}_");
				}
			} else {
				$data[$key] = is_bool($value) ? (int) $value : $value;
			}
		}
		return $data;
	}

	/**
	 * Check for Vimeo URLs and render the data if found
	 *
	 * Based on TextformatterVideoEmbed::embedVimeo by Ryan Cramer.
	 *
	 * @param string $str
	 *
	 */
	protected function renderVimeo(&$str) {

		if(strpos($str, 'vimeo.com/') === false) return;

		if(!preg_match_all(
			'#' .
			($this->html ? '<p>' : '') .
			'\s*(https?://(?:www\.)?vimeo\.com/\S*)' .
			($this->html ? '</p>' : '') .
			'#',
			$str,
			$matches
		)) return;

		foreach($matches[0] as $key => $line) {
			$url = $this->applyVimeoOptions($matches[1][$key]);
			$str = $this->replace($str, $this->getData('vm', $url), $line);
		}
	}

	/**
	 * Check for Youtube URLs and render the data if found
	 *
	 * Based on TextformatterVideoEmbed::embedYoutube by Ryan Cramer.
	 *
	 * @param string $str
	 *
	 */
	protected function renderYoutube(&$str) {

		// perform a strpos fast check before performing regex check
		if(strpos($str, 'youtube.com/watch') === false
			&& strpos($str, 'youtube.com/v/') === false
			&& strpos($str, 'youtube.com/shorts/') === false
			&& strpos($str, 'youtu.be/') === false) return;

		if(!preg_match_all(
			'#' .
			($this->html ? '<p>' : '') .
			'\s*(https?://(?:www\.)?youtu(?:\.be|be\.com)+/(?:watch/?\?v=|v/|shorts/)?([^\s&<\'"]+)(&[-_,.=&;a-zA-Z0-9]*)?).*?' .
			($this->html ? '</p>' : '') .
			'#',
			$str,
			$matches
		)) return;

		foreach($matches[0] as $key => $line) {
			$originalUrl = $matches[1][$key];
			$url = $this->applyYoutubeOptions($originalUrl);
			$str = $this->replace($str, $this->getData('yt', $url, $originalUrl), $line);
		}
	}

	/**
	 * Replace the URL with the rendered markup
	 *
	 * @param string $str
	 * @param array $data
	 * @param string $line
	 * @return string
	 *
	 */
	protected function replace($str, $data, $line) {
		return str_replace(
			$line,
			empty($data) ?
				// No data returned - render the configured emptyValue (also allows
				// the render() hook to customise the empty-value output, per README).
				$this->render($this->markupTpl, false, $line) :
				$this->render(($this->markupTpl ?: ($data['debug'] ? '{debug}' : '{html}')), $data, $line),
			$str
		);
	}
}
